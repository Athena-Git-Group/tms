# docker compose 的本機私人設定範本。用法：cp .env.example .env 再改 .env。
# .env 不進版控；沒有 .env 時，docker-compose.yml 會用下面同樣的預設值。

# Conduktor Console 登入帳密（docker compose --profile conduktor up -d，http://localhost:8088）
# 密碼至少 8 碼，要有大寫、小寫、數字、符號，不然 Console 起不來。
CDK_ADMIN_EMAIL=admin@tms.local
CDK_ADMIN_PASSWORD=Tms_local1!

# Conduktor 授權碼。留空就以免費的社群版執行。
CDK_LICENSE=
