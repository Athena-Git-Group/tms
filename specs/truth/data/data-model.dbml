// TMS 持久化模型：系統目前唯一的 data truth。
// 來源：由基線 specs/tms-poc-to-backend/db_table/erm.dbml 遷入，並套用 plan 001-staff-app-increment 的增量。
// 全檔慣例：每張業務表首欄 tenant_id（bigint → tenants.id）；實體表 PK=uuid（UUIDv7，app 層產號）；
// 跨表引用一律複合外鍵 (tenant_id, xxx_id) REFERENCES 對方 (tenant_id, id)，被引用表補 UNIQUE (tenant_id, id)；
// enum 一律 text + CHECK（註記於 note）；應用層 tenant scope + Postgres RLS 第二道；
// FK 行為一律 ON DELETE RESTRICT / ON UPDATE RESTRICT（業務不硬刪：停用/作廢/去識別化代替刪除）。

Project tms {
  database_type: 'PostgreSQL'
  Note: '''
  多租戶 SaaS。task_events 為唯一真相（DB 權限收走 UPDATE/DELETE；唯一例外=受控去識別化函式）。
  tasks/room_memory/stats_daily/phrase_counter/cleaning_time_stats/task_sop_checks 為投影，可清空由事件流重建。
  '''
}

Table tenants {
  id         bigint      [pk, increment, note: '即各表 tenant_id（docs/12 例外二：集中開設、量少，8 bytes 省索引）']
  name       text        [not null, note: '飯店名']
  created_at timestamptz [not null]
  Note: '租戶（飯店）主檔。v1 由營運人工開設。'
}

Table tenant_config {
  tenant_id  bigint      [not null, ref: > tenants.id]
  key        text        [not null, note: '封閉鍵集：standard_cleaning_minutes|shift_capacity|inspection_items|sop_items|guest_info_pages|request_menu|minutes_per_credit|classification_rules|scan_fail_threshold|low_rating_threshold|shift_times|retention_days|inspection_waived_cleaning_types（本 plan 新增：免查房的打掃種類，值為打掃種類陣列，預設 ["stayover"]）|unclaimed_reminder_minutes（本輪新增：待認領未接提醒門檻，一般單與急件各自的提醒同仁／通知主管分鐘數，值如 {"cleaning":{"staffReminded":10,"managerNotified":20},"urgent":{"staffReminded":3,"managerNotified":8}}；取代已隨裁決 B 廢除的 sla_minutes_cleaning|sla_minutes_amenity|sla_minutes_other|escalation_step_minutes|escalation_chain_enabled）|notification_retention_days（本輪新增：通知中心保留天數，值為整數，預設 30；排程依此清除 notifications 逾期列，資料層預設，不是行為 truth）|completion_celebration_enabled（002 新增：完成慶祝的氣氛呈現開關，值為 boolean，預設 true。false 時完成畫面仍出現、接續按鈕仍可用，只是不呈現飾帶、彩屑、入場動態與今日進度——關掉的是氣氛，不是接力。這一鍵只影響呈現，不影響 tasks 的任何欄位，也不影響「今天第幾單」與「完成後的接續去向」兩個衍生值的計算）']
  value      jsonb       [not null, note: '結構依 key 而異']
  updated_at timestamptz [not null]
  updated_by uuid        [note: '→ staff_accounts；設定變更要能追']
  Indexes {
    (tenant_id, key) [unique]
  }
  Note: '「什麼都可調」的落地。inspection_items/sop_items 兩鍵為 sop_items 表的門面（讀寫轉進表）。'
}

Table staff_accounts {
  id            uuid        [pk]
  tenant_id     bigint      [not null, ref: > tenants.id]
  name          text        [not null, note: 'PII：離職去識別化換不可回推代號']
  login_id      text        [not null, note: 'PII；UNIQUE (tenant_id, login_id)']
  password_hash text        [not null, note: 'bcrypt/argon2，絕不存明文']
  role          text        [not null, note: 'CHECK: frontdesk|housekeeping|engineering|manager|duty_manager|owner（duty_manager 原為逾時升級鏈 L3 收件人；該升級鏈隨裁決 B 廢除為兩段式未接提醒，收件人改為既有 manager 角色，duty_manager 值由 features truth 背景保留但目前無對應收件情境）']
  dept          text        [note: 'CHECK: housekeeping|engineering|frontdesk；主管/老闆可空。role=manager 時用來分主管種類：dept=engineering 為工務主管，其餘（含 NULL、housekeeping、frontdesk）為房務主管。主管種類是衍生值，不另存欄位，只決定主管看得到哪幾類待辦與能不能送出查房，不影響誰能驗收工務單']
  active        boolean     [not null, default: true, note: '停用=不能登入，歷史保留']
  must_change_password boolean [not null, default: false, note: '本輪新增。臨時密碼登入成功後為 true；完成改密前這組憑證呼叫其他需要身分的 API 一律被拒。對應 contracts staff_accounts.mustChangePassword、LoginResponse.mustChangePassword']
  failed_login_count   int     [not null, default: 0, note: '本輪新增。連續輸入錯誤密碼的次數；登入成功即清零；達 5 次時連同 locked_until 一併寫入鎖定']
  locked_until         timestamptz [note: '本輪新增，nullable。連續輸入錯誤密碼達 5 次時鎖定 15 分鐘的到期時間；未鎖定為 NULL；鎖定中登入一律 429 account_locked']
  created_at    timestamptz [not null]
  updated_at    timestamptz [not null]
  Indexes {
    (tenant_id, login_id) [unique]
    (tenant_id, id) [unique, note: '複合外鍵落點']
    (tenant_id, dept)
  }
  Note: '''
  員工帳號。角色×動作矩陣在程式/設定，不在表裡（docs/11 需求 15）。
  不變條件：登入成功清零 failed_login_count 並清空 locked_until；登入密碼錯誤 failed_login_count+1，達 5 次時寫入 locked_until=now()+15min；鎖定中一律 429，不再累加次數。
  '''
}

Table staff_devices {
  id                 uuid        [pk]
  tenant_id          bigint      [not null, ref: > tenants.id]
  staff_id           uuid        [not null]
  device_fingerprint text        [not null, note: '只做去重，不做綁定（docs/11 不在範圍內）']
  push_token         text        [note: 'FCM 推播地址（iOS 也經 FCM 轉 APNS）；由 registerPushToken 回報，權限被關即空']
  platform           text        [note: 'CHECK: ios|android；登入時順手登記、還沒帶平台的舊列為 NULL。iOS 送出時額外附 APNS alert 與 content-available']
  registered_at      timestamptz [not null]
  revoked_at         timestamptz [note: '登出（revokePushToken）或推播服務回報地址失效（FCM UNREGISTERED／INVALID_ARGUMENT）時標記']
  Indexes {
    (tenant_id, staff_id, device_fingerprint) [unique]
  }
  Note: '推播地址簿：一列=一台裝置。登入不驗裝置、多機合法。'
}

Table push_deliveries {
  id                 bigserial   [pk]
  tenant_id          bigint      [not null, ref: > tenants.id]
  idempotency_key    text        [not null, note: '與 outbox.idempotency_key 同一把鍵；推播消費者處理前先查，已是 sent 或 skipped_no_token 就跳過']
  recipient_staff_id uuid        [not null]
  status             text        [not null, note: 'CHECK: sent|skipped_no_token|failed。sent＝至少一台手機送出成功；skipped_no_token＝收件人沒有未撤銷且有地址的手機；failed＝每台都失敗（含暫時性錯誤等待重試中、重試用盡）']
  attempts           int         [not null, default: 0, note: '消費者處理這把鍵的次數，含暫時性錯誤後的重試']
  last_error         text        [note: '最後一次失敗的原因']
  created_at         timestamptz [not null]
  sent_at            timestamptz [note: '第一台手機送出成功的時間']
  Indexes {
    (tenant_id, idempotency_key) [unique]
    (tenant_id, recipient_staff_id, created_at)
  }
  Note: '推播送達紀錄：一列＝一把冪等鍵（outbox 的一筆 push）。讓消費者認出 relay／Kafka 重送、也讓人查得到為什麼沒送到。'
}

Table rooms {
  id         uuid        [pk]
  tenant_id  bigint      [not null, ref: > tenants.id]
  room_no    text        [not null, note: '房號「305」']
  floor      int         [not null, note: 'v1 排房演算法排序鍵']
  room_type  text        [not null, note: '平均打掃分鐘按它統計']
  hk_state   text        [not null, note: 'TMS 擁有。CHECK: dirty|cleaned|inspected|out_of_order']
  occupancy  text        [not null, note: 'PMS 擁有（同步唯讀）。CHECK: occupied|vacant']
  updated_at timestamptz [not null]
  Indexes {
    (tenant_id, room_no) [unique]
    (tenant_id, id) [unique, note: '複合外鍵落點']
  }
  Note: '''
  房間主檔，兩系統各管一半、不共用欄位。
  不變條件：hk_state 只由任務引擎修改（查房通過→inspected、退回→dirty；免查結案→cleaned，抽查退回→dirty）；occupancy 只由 PMS 同步修改。
  '''
}

Table room_qr_tokens {
  id         uuid        [pk]
  tenant_id  bigint      [not null, ref: > tenants.id]
  room_id    uuid        [not null]
  token      text        [not null, unique, note: '≥128 bit 隨機 base62 約 22 字元，不含房號資訊；全域 UNIQUE']
  version    int         [not null, note: '重產 +1']
  status     text        [not null, note: 'CHECK: active|revoked']
  created_at timestamptz [not null]
  revoked_at timestamptz
  Indexes {
    (tenant_id, room_id) [unique, note: 'partial UNIQUE WHERE status=\'active\'——一房同時僅一枚現行']
  }
  Note: '''
  房間 QR 憑證（Guest Access 擁有）。
  不變條件：輪替=同一交易「舊 token→revoked＋新列 version+1＋該房全部未撤銷 guest_sessions 標 revoked_at」（E-18 連坐撤銷）。
  '''
}

Table guest_sessions {
  id             uuid        [pk]
  tenant_id      bigint      [not null, ref: > tenants.id]
  session_token  text        [not null, unique, note: '住客瀏覽器憑證；全域 UNIQUE']
  room_id        uuid        [not null]
  reservation_id uuid        [not null, note: '綁簽發當下訂單——換住客舊 session 自然失效']
  expires_at     timestamptz [not null, note: '=退房時間']
  revoked_at     timestamptz [note: 'QR 輪替/提前退房/訂單取消時整批標上']
  created_at     timestamptz [not null]
  last_seen_at   timestamptz
  Indexes {
    (tenant_id, room_id)
  }
  Note: '不變條件：驗證=expires_at > now() AND revoked_at IS NULL，缺一即 401（E-17）。'
}

Table reservations_cache {
  id              uuid        [pk]
  tenant_id       bigint      [not null, ref: > tenants.id]
  reservation_ref text        [not null, note: 'PMS 訂單編號；Excel 匯入列合成 excel:日期:房號']
  room_id         uuid        [not null]
  guest_name      text        [note: 'PII：去識別化範圍']
  lang            text        [note: '住客端語言']
  attrs           jsonb       [note: 'VIP/親子/寵物/紀念日——自動開準備工單依據']
  checkin_at      timestamptz [not null]
  checkout_at     timestamptz [not null]
  source          text        [not null, note: 'CHECK: pms|excel']
  synced_at       timestamptz [not null]
  superseded_at   timestamptz [note: 'PMS 恢復比對到住期重疊真訂單時標上；當前訂單查詢一律 IS NULL']
  Indexes {
    (tenant_id, reservation_ref) [unique]
    (tenant_id, id) [unique, note: '複合外鍵落點']
    (tenant_id, room_id, checkout_at) [note: '今日退房與當前訂單']
  }
  Note: '''
  訂房檔唯讀副本（真相在 PMS）。
  不變條件：EXCLUDE 約束——同房、住期區間重疊、皆未作廢 → 拒絕寫入（E-10；DBML 無法表達，migration 以
  EXCLUDE USING gist (tenant_id WITH =, room_id WITH =, tstzrange(checkin_at, checkout_at) WITH &&) WHERE (superseded_at IS NULL) 落地）。
  '''
}

Table tasks {
  id             uuid        [pk]
  tenant_id      bigint      [not null, ref: > tenants.id]
  type           text        [not null, note: 'CHECK: amenity|repair|cleaning|other']
  source         text        [not null, note: 'CHECK: guest|desk|system|staff（staff 為本 plan 新增：房務開立的工務單）']
  room_id        uuid        [not null]
  reservation_id uuid        [note: 'guest 來源必填；住客查詢一律以它過濾（不按房號）']
  dept           text        [not null, note: 'CHECK: housekeeping|engineering|frontdesk（triage 時掛 frontdesk）']
  state          text        [not null, note: 'CHECK 十值: triage|pool|accepted|doing|done|inspected|closed|deferred|interrupted|cancelled。closed（已結案）只有 type=repair 會出現：主管驗收通過，或完修結果為 no_action_needed 時完成當下直接進入；它與 cleaning 的 inspected 對稱，是工務單唯一的完成終點。type=repair 的 done 是「已完修、等主管驗收」，還沒結束']
  event_seq      int         [not null, default: 0, note: '事件取號器：守衛 UPDATE 同句 +1 RETURNING']
  assignee_id    uuid        [note: '池中為空']
  title          text        [not null]
  note           text        [note: '住客原文/翻譯/交代/當場回答——PII 去識別化範圍']
  est_min        int         [note: '排房帶入；credit 換算屬 Q1 未決']
  started_at     timestamptz [note: '第一次開工時間；查房退回或抽查退回時清空重計']
  done_at        timestamptz [note: '完成時間。實際分鐘不再用 done_at−started_at 推導，改看 worked_sec。工務單是最近一次完修的時間：驗收不通過退回重修時清空，再完修時重寫；驗收通過或以 no_action_needed 結案時保留']
  worked_sec     int         [not null, default: 0, note: '本 plan 新增。已結束的 doing 段落累計秒數，不含中斷期間。實際工時＝worked_sec（完成時）；已做時間＝worked_sec＋（doing 時 now−segment_started_at）。查房與抽查退回時歸零']
  segment_started_at timestamptz [note: '本 plan 新增。目前這段 doing 的開始時間，只在 doing 時有值；中斷時把這段併進 worked_sec 並清空']
  inspection     text        [note: '本 plan 新增。CHECK: passed|waived|failed；只有 cleaning 有值。查房全過為 passed，免查結案為 waived，查房或抽查退回為 failed。合格率只計 passed 與 failed']
  inspection_waived boolean  [not null, default: false, note: '本 plan 新增。開工當下依 tenant_config.inspection_waived_cleaning_types 鎖定，之後設定變更不影響；退回重做時保留原鎖定值']
  hold_reason    text        [note: '本 plan 新增。停住原因：本人延後或中斷的原因（1–60 字）、「等工務：<類別>」、「工務已修好：<類別>」；離開 deferred 或 interrupted 時清空']
  deferred_by_self boolean   [not null, default: false, note: '本 plan 新增。state=deferred 時，true＝本人延後（保留 assignee，班末掃描退池）；false＝主管延後（無 assignee，隔日自動回池、可 undefer）']
  linked_repair_task_id uuid [note: '本 plan 新增。以中斷模式開立工務單時，原任務連結到那張工務單（→ tasks.id，type=repair）']
  cancel_reason  text        [note: '本 plan 新增投影欄位（原本只在事件 payload）。CHECK: guest_withdrew|manager_void|plan_superseded|staff_withdrew；staff_withdrew 為本 plan 新增']
  urgent         boolean     [not null, default: false, note: '本 plan 新增。只有 repair 會是 true；待認領排在所有非急件之前。本輪起與 repair_tickets.is_urgent 同步（開單判定與主管降級時一併寫入），本欄只是供排序索引直接用、避免 JOIN repair_tickets，權威判定結果看 repair_tickets.is_urgent/urgent_rule']
  priority_notify boolean    [not null, default: false, note: '本 plan 新增投影欄位（原本只在事件）。請假退回、主管附交代退池時為 true；待認領排序第二鍵']
  reminder_stage text        [note: '本輪新增。CHECK: staff_reminded|manager_notified，NULL＝尚未進入未接提醒。只有 state=pool 時有意義：排程依 tenant_config.unclaimed_reminder_minutes（依 urgent 分一般／急件門檻）掃描，到門檻時寫入該階段並各發一次推播（PushPayload.event=unclaimed_reminder_staff|unclaimed_reminder_manager），每階段只發一次；任務離開 pool（認領、改派、撤回等）時清空為 NULL。待認領排序以「不是 NULL」排最前（彼此間依房號），其餘維持既有排序。對應 contracts PoolItem.reminderStage']
  pool_source    text        [note: '本 plan 新增投影欄位。最近一次進池的來源標籤。CHECK: guest_scan|desk_forward|manager_requeue|leave_return|shift_end_return|inspection_return|verification_return|staff_report|system。verification_return＝工務單驗收不通過時原處理人已下班或請假，單回到工務待認領']
  return_reason  text        [note: '本 plan 新增投影欄位。最近一次退池的原因，例如「小陳請假」、「班末退池 · 交給下一班」']
  requeue_note   text        [note: '本 plan 新增投影欄位。接手進度交代，例如「浴室已刷完，還沒換床單」；任務詳情的交辦以 requeue_progress 顯示。PII 去識別化範圍']
  due_at         timestamptz [note: '自動化規則增補。系統準備工單的到期時間顯示（規則可設「建單後 N 分鐘到期」），與未接提醒／裁決 B 廢除的逾時升級鏈無關，純粹是準備工單自己的到期時刻標示']
  rule_hit       text        [note: '自動化規則增補。自動化規則命中的規則名；冪等鍵＝房號｜規則｜當地日期']
  redo_count     int         [not null, default: 0]
  rating         int         [note: 'CHECK 1–5；低分觸發老闆推播；一次性（假設 A5）']
  plan_id        uuid        [note: '打掃任務回鏈排房計畫']
  work_date      date        [note: '打掃必填（發佈抄自計畫日）——支撐一房一天約束與班末掃描']
  created_at     timestamptz [not null]
  updated_at     timestamptz [not null]
  Indexes {
    (tenant_id, dept, state) [note: '待認領與看板']
    (tenant_id, assignee_id, state) [note: '個人在手']
    (tenant_id, room_id, created_at) [note: '單房歷程']
    (tenant_id, reservation_id, created_at) [note: '住客本次住宿需求']
    (tenant_id, id) [unique, note: '複合外鍵落點']
    (tenant_id, room_id, work_date) [unique, note: 'partial UNIQUE WHERE type=\'cleaning\' AND state NOT IN (\'done\',\'inspected\',\'cancelled\')——一房一天僅一筆未完成打掃（E-09）']
    (tenant_id, assignee_id) [unique, name: 'uq_tasks_one_doing_per_staff', note: '本 plan 新增。partial UNIQUE WHERE state=\'doing\'——一位員工同時最多一筆 doing（FR-001）。守衛 UPDATE 違反時回 409 doing_task_exists']
    (tenant_id, dept, state, reminder_stage, urgent, priority_notify) [note: '本 plan 新增，本輪補 reminder_stage。待認領排序（未接超時＝reminder_stage 不是 NULL→急件→優先通知→同樓層→房號）；reminder_stage 只要求「是否為 NULL」排前後，兩個非 NULL 值之間不分順序']
  }
  Note: '''
  任務投影（可由 task_events 重放重建）。
  不變條件：state 轉移全集見 spec §5.1；守衛=一句條件式 UPDATE（0 列→409）；
  只有任務引擎可寫；cancelled 不進任何統計（E-15）；僅 cleaning 走 inspected，僅 repair 走 closed。
  本 plan 新增的轉移（由任務引擎守衛，非法回 409）：
    accepted→deferred（本人延後，deferred_by_self=true）；deferred(self)→doing（本人開工）；
    doing→interrupted（本人中斷）；interrupted→doing（本人恢復）；
    doing→inspected（cleaning 且 inspection_waived=true，inspection=waived）；
    inspected(waived)→accepted（抽查退回：redo+1、worked_sec 與勾記歸零、inspection=failed）；
    repair 的 pool→cancelled（報修人撤回，cancel_reason=staff_withdrew）。
  工務單（type=repair）的狀態轉移（由任務引擎守衛，非法回 409）：
    開單：房務報修、工務自開、櫃檯交辦、定期保養一律進 pool，一般件與急件都一樣，沒有主管審核；直開且帶 assigneeId 時直接 accepted（略過待認領）。
    pool→accepted（認領或指派）→doing→done：完修結果為 fixed、temporary、cannot_fix 時停在 done 等主管驗收。
    doing→closed：完修結果為 no_action_needed 時，完成那一句守衛 UPDATE 直接寫 closed，不經 done（與免查房打掃 doing→inspected 同一種寫法）。
    done→closed：主管驗收通過，同一交易寫 repair_tickets.verified_by／verified_at，task_events.type=repair_verified。
    done→accepted：主管驗收不通過且原處理人在班，assignee_id 不變。
    done→pool：主管驗收不通過且原處理人已下班或請假，assignee_id 清空、pool_source=verification_return、return_reason 記「驗收不通過 · 原處理人已下班或請假」。
      驗收不通過的兩條路都在同一交易：done_at 清空，repair_tickets 寫 last_verify_failed_reason／_by／_at 並清空 resolution_type、resolution_note，
      task_events 只寫一筆 repair_verification_failed（payload 帶去處）。worked_sec、started_at、redo_count 不動：重修的工時接著累計，重做次數只屬於查房。
    驗收通過與不通過都以 state='done' 為守衛條件：兩位主管同時送出，只有先到的那句 UPDATE 改到列，後到的 0 列回 409。closed 是終點，不能再驗收、撤回或取消。
  驗收不通過的「原處理人已下班或請假」與查房退回換人共用同一套判定（InspectionService 的換人規則，以注入的 Clock 為現在）：
    請假中（leaves 區間涵蓋現在）、現在落在飯店所有班別時段（tenant_config.shift_times）之外，或已過他最近一份排房計畫班次（plan_rooms→cleaning_plans.shift）的下班時間，任一成立即視為接不了；
    都判定不了時視為在班，退回他名下。排房計畫只排房務，工務人員沒有個人班次，所以對工務實際只看前兩項：班別時段內、沒有請假的工務人員一律算在班。
  「已結束」的狀態：cleaning 以外的 done、inspected、closed 都算完成，cancelled 是取消。工務單的 done 只是已完修：
    主管待辦、工務單詳情的步驟條與狀態列必須分辨 done 與 closed；今日完成數、今天已完修、首頁任務列的已結束組、重複報修檢查等原本把 done 當成已結束的讀取端，一律要同時認得 closed。
  班末掃描：assignee 名下 accepted 與 deferred(self) →pool（pool_source=shift_end_return）；doing 不動；interrupted 不動並推播主管。
  待認領未接提醒（本輪新增，取代原逾時升級鏈 L1/L2/L3）：排程依 tenant_config.unclaimed_reminder_minutes 掃描 state=pool 的任務，
  一般單與急件各自的「提醒同仁」「通知主管」門檻各只跨越一次、各發一次推播並寫入 reminder_stage；離開 pool 時 reminder_stage 清空，
  不保留歷史（沿用既有投影可清空重建的精神，由排程重新計算，不需要額外的 task_events 型別）。
  完成當下的兩個衍生值（本輪新增說明，不新增欄位）：
    「今天第幾單」＝本人今日（work_date＝今天）未取消的 cleaning 任務中，state 為 done 或 inspected 的數量，
    含 inspection_waived 直接結案者；與首頁已清完間數同一個計數，不另存計數欄位，否則兩個畫面會各算各的。
    「完成後的接續去向」＝先找本人今日 state=accepted 的單（沿用既有下一間排序），沒有時再找本人今日
    state 為 doing、interrupted、deferred 的單，依 doing→interrupted→deferred、同組 room_no 遞增取第一筆；
    兩者皆無即為「今天排定的房都清完了」。兩段查詢都走既有索引 (tenant_id, assignee_id, state)，不新增索引。
    「今天」的判定沿用既有口徑：work_date 有值時比 work_date，沒有值（非打掃類）時未結束狀態一律算今天、
    已結束（done、inspected、closed）看 done_at 是否落在今天；兩個新值與 todayTasks／nextTasks 必須共用這一套，否則同一張單會在不同畫面有兩種歸屬。
  主管待辦的兩類判定（衍生值：不新增欄位、不新增資料表、不新增索引；只看單目前的狀態，不帶日期條件，每格數字與清單列數出自同一條查詢）：
    誰看得到：主管種類由 staff_accounts.role 與 dept 推得（見 staff_accounts.dept）。房務主管看待查房與待驗收，工務主管只看待驗收；查房送出也只開放房務主管。
    待查房＝type=cleaning 且 state=done 且 assignee_id 不是正在查看的主管本人（主管不能查自己清的房，E-07；另一位房務主管看得到這張單）。
      免查房的單完成時直接落在 inspected（inspection=waived），本來就不會停在 done，不需另加條件；也不看 inspection 欄位，
      因為抽查退回重做的單在重做完成後可能還留著上一次的 failed。排序鍵＝done_at，即最近一次完成的時間（退回重做後再完成會重寫）。
    待驗收＝type=repair 且 state=done 且 repair_tickets.resolution_type IS DISTINCT FROM 'no_action_needed'。對所有主管是同一份，
      不排除查看者本人完修的單（工務主管可以驗收自己修的單）。含完修結果為 fixed、temporary、cannot_fix 的單與 origin=scheduled 的保養單。
      no_action_needed 完成時直接落在 closed，本來就不會停在 done；條件仍排除它，防止狀態寫入有落差時誤列。用 IS DISTINCT FROM 而不是 <>，
      讓 resolution_type 為 NULL 的舊完修單照樣列入。不看 verified_at：驗收通過即離開 done。維修中（doing）、退回重修中（accepted 或 pool）、
      已結案（closed）都不在內。排序鍵＝done_at，即最近一次完修的時間；退回重修後再完修會重寫，依新的完修時間排位置。
    篩選走既有索引 (tenant_id, dept, state)（待查房 dept=housekeeping、待驗收 dept=engineering），再以 type 與 assignee_id 過濾；
    待驗收以 task_id 主鍵 JOIN repair_tickets。兩類排序一律由舊到新，同一時刻依房號再依單號，不分日期；清單上要不要標日期看排序鍵落在哪一個日曆日，不看 work_date，
    日界線沿用後端注入的 Clock 時區（資料層目前沒有每租戶的時區設定，與 todayTasks 的「今天」同一把尺）。
  '''
}

Table task_events {
  id         bigint      [pk, increment, note: '全館依序，但非訂閱書籤（增量一律走 Kafka）；僅離線重放/排查排序用']
  tenant_id  bigint      [not null, ref: > tenants.id]
  task_id    uuid        [not null]
  seq        int         [not null, note: '這個任務的第幾步；取自 tasks.event_seq 的 RETURNING']
  type       text        [not null, note: '24 值: created|triaged|assigned|claimed|started|completed|inspection_passed|inspection_failed|reassigned|returned_to_pool|interrupted|deferred|answered|rated|sop_checked|plan_adjusted|checkout_imported|cancelled|resumed|inspection_waived|repair_photos_appended|urgent_downgraded|repair_verified|repair_verification_failed。urgent_downgraded＝主管將工務單急件降級為一般件；repair_verified＝主管驗收通過（done→closed）；repair_verification_failed＝主管驗收不通過（done→accepted 或 pool）；後三者只適用 type=repair。資料庫不對本欄設 CHECK（加值不改表），值集以這裡為準。repair_approved、repair_rejected、repair_resubmitted 已停用，不再寫入，歷史列的讀法見表 Note']
  actor_role text        [not null, note: 'guest|frontdesk|housekeeping|engineering|manager|system']
  actor_id   uuid        [note: '住客與系統為空']
  payload    jsonb       [note: '會改 tasks 欄位的事件必填帶齊（created 帶建立快照）；cancelled 帶原因 guest_withdrew|manager_void|plan_superseded|staff_withdrew；deferred 與 interrupted 帶 reason 與 by_self；inspection_failed 帶 spot_check（抽查時為 true）；工務單 created 與 repair_photos_appended 只帶照片張數 photo_count，不含照片本體（NFR-004）；urgent_downgraded 帶 downgradeReason（主管附的降級原因，即 repair_tickets.urgent_downgrade_reason）；repair_verification_failed 帶 reason（不通過原因，即 repair_tickets.last_verify_failed_reason）與 destination（assignee＝回原處理人名下｜pool＝回工務待認領），另帶 assigneeId（原處理人，兩種去處都帶，pool 時是重放還原「推播給誰、退的是誰的單」的唯一來源）；repair_verified 不帶 payload；type=repair 的 completed 必帶 resolutionType（fixed｜temporary｜cannot_fix｜no_action_needed，請求省略時寫 fixed，即 repair_tickets.resolution_type），no_action_needed 時這一筆 completed 就是結案事件（state 直接成為 closed），不另寫 repair_verified，temporary 時另帶 originTicketTaskId（新建追蹤單的 task_id，即 repair_tickets.origin_ticket_task_id 的對方）；打掃類 completed 帶 skipped_items（完成時被自動標為跳過的 SOP 項目標籤）']
  created_at timestamptz [not null]
  Indexes {
    (tenant_id, task_id, seq) [unique]
    (tenant_id, id) [note: '離線全表重放']
  }
  Note: '''
  唯一真相，只進不改：DB 權限收走 UPDATE/DELETE（E-13）。
  唯一例外=受控去識別化函式（抹 payload 個資、帳號代號化、執行記一筆事件）。
  驗收：CI 影子庫清空 tasks 重放比對（SC-006）。
  工務單驗收的歷程以本表為準：每次不通過一筆 repair_verification_failed、通過一筆 repair_verified；repair_tickets 只投影最近一次不通過與通過的那一次。
  已停用的型別：repair_approved、repair_rejected、repair_resubmitted 不再寫入，本表只進不改，歷史裡已有的列保留不刪。
  重放時依「工務單沒有主管審核」解讀：created 快照的起點若是 pending_review 視為 pool，三種停用事件只推進 seq、不改任何 tasks 欄位；
  如此重放結果與既有任務列的處置一致（等審核與被退回的單都在 pool）。
  '''
}

Table outbox {
  id              bigint      [pk, increment]
  tenant_id       bigint      [not null, ref: > tenants.id]
  aggregate_key   text        [not null, note: 'Kafka 分區鍵：task_event/push 用 task:<uuid>；pms_status 一律 room:<tenant_id>:<uuid>（跟一致性邊界走）']
  kind            text        [not null, note: 'CHECK: task_event|push|pms_status（minibar 啟用時再加 pms_minibar）。push 的 payload 形狀＝contracts PushPayload（event、title、target）；pms_status 的值為 vacant_clean（查房通過）或 occupied_clean（免查結案，OC）']
  payload         jsonb       [not null]
  idempotency_key text        [not null, note: '下游去重：重送不重做']
  status          text        [not null, default: 'pending', note: 'CHECK: pending|sent|failed（重試用盡等人工）']
  attempts        int         [not null, default: 0]
  next_retry_at   timestamptz [note: '指數退避']
  created_at      timestamptz [not null]
  sent_at         timestamptz
  Indexes {
    (tenant_id, kind, idempotency_key) [unique]
    (aggregate_key, id) [note: 'partial index WHERE status=\'pending\'——relay 依鍵輪詢']
  }
  Note: '''
  待送匣=交易護欄：與狀態變更同交易落庫。
  不變條件：relay 同鍵串行（同 aggregate_key 最早一筆未 sent 不送後續，E-14）；
  sent 保留 3 天後排程清除；Kafka 下游一律不回寫 tasks。
  '''
}

Table processed_ops {
  tenant_id  bigint      [not null, ref: > tenants.id]
  op_id      text        [not null, note: '客戶端 Idempotency-Key（UUID）']
  result_ref jsonb       [not null, note: '狀態碼＋精簡回應，重送原樣回放']
  created_at timestamptz [not null, note: '7 天後排程清']
  Indexes {
    (tenant_id, op_id) [pk]
  }
  Note: '弱網重送去重簿（GR-002/E-11）。'
}

Table cleaning_plans {
  id           uuid        [pk]
  tenant_id    bigint      [not null, ref: > tenants.id]
  work_date    date        [not null]
  shift        text        [not null, note: '值域從租戶設定 shift_times 來']
  status       text        [not null, note: 'CHECK: draft|published|superseded']
  version      int         [not null, default: 0, note: '每次調整 +1；PUT 帶 If-Match，不符 409＋最新內容（E-08）']
  generated_by text        [not null, note: 'CHECK: system|manager']
  algo_version text        [not null, note: 'v1=樓層×工時一層一人；Q4 v2 對照用']
  generated_at timestamptz [not null]
  published_at timestamptz
  Indexes {
    (tenant_id, work_date, shift) [unique, note: 'partial UNIQUE WHERE status=\'published\'——一班同時僅一份已發佈；草稿不限']
    (tenant_id, id) [unique, note: '複合外鍵落點']
  }
  Note: '''
  排房計畫。不變條件：發佈切換同一交易＝新 published＋舊標 superseded＋任務對帳三分支
  （共有房未開始改掛新計畫 reassigned；舊有新無未開始 cancelled 原因 plan_superseded；doing 不動、列清單給主管）。
  '''
}

Table plan_rooms {
  id        uuid [pk]
  tenant_id bigint [not null, ref: > tenants.id]
  plan_id   uuid [not null]
  room_id   uuid [not null]
  staff_id  uuid [not null, note: '誰在哪天負責哪些房查這張']
  est_min   int  [not null, note: '抄自 cleaning_time_stats，樣本<20 用標準工時']
  route_seq int  [not null, note: '建議打掃順序（v1=照樓層）']
  task_id   uuid [note: '發佈後回填對應打掃任務']
  Indexes {
    (tenant_id, plan_id, room_id) [unique]
    (tenant_id, plan_id, staff_id) [note: '個人當日清單']
  }
  Note: '計畫明細（Plan×Room×Staff junction）。'
}

Table cleaning_time_stats {
  tenant_id      bigint      [not null, ref: > tenants.id]
  room_type      text        [not null]
  avg_actual_min numeric(6,1) [not null, note: 'derived：流水帳 completed−started 平均（退回以最後一輪為準）']
  sample_count   int         [not null, note: '<20 時排房用標準工時']
  updated_at     timestamptz [not null]
  Indexes {
    (tenant_id, room_type) [pk]
  }
  Note: '投影（可重算）。只到房型層級、不含個人（個人工時受分級可見與保留期限管）。'
}

Table sop_items {
  id         uuid        [pk]
  tenant_id  bigint      [not null, ref: > tenants.id]
  applies_to text        [not null, note: 'CHECK: cleaning|inspection——SOP 項目與查房項目同構共表']
  item_key   text        [not null]
  label      text        [not null]
  sort_order int         [not null]
  active     boolean     [not null, default: true]
  created_at timestamptz [not null]
  Indexes {
    (tenant_id, applies_to, item_key) [unique]
  }
  Note: '每家飯店自設的 SOP/查房項目（reference）。/admin/settings 的 sop_items/inspection_items 鍵為本表門面。'
}

Table task_sop_checks {
  id         uuid        [pk]
  tenant_id  bigint      [not null, ref: > tenants.id]
  task_id    uuid        [not null]
  item_key   text        [not null]
  label      text        [not null, note: '建單當下快照（項目日後改名不影響歷史單）']
  checked    boolean     [not null, default: false]
  skipped    boolean     [not null, default: false, note: 'CHECK NOT (checked AND skipped)；跳過不擋流程但留痕']
  checked_by uuid
  checked_at timestamptz
  Indexes {
    (tenant_id, task_id, item_key) [unique]
  }
  Note: '投影：查房退回時歸零重來；「誰在幾點勾過什麼」的歷史在 task_events（sop_checked）。'
}

Table inspections {
  id           uuid        [pk]
  tenant_id    bigint      [not null, ref: > tenants.id]
  task_id      uuid        [not null]
  inspector_id uuid        [not null, note: '守衛：inspector ≠ 原清房者（403）']
  result       text        [not null, note: 'CHECK: passed|failed']
  items        jsonb       [not null, note: '[{key, pass}]；鍵集=租戶查房項目全集（缺項 422）']
  created_at   timestamptz [not null]
  Indexes {
    (tenant_id, task_id)
  }
  Note: '查房記錄（history，一次查房一列；退回重查會有多列）。'
}

Table handovers {
  id           uuid        [pk]
  tenant_id    bigint      [not null, ref: > tenants.id]
  dept         text        [not null, note: 'CHECK: housekeeping|engineering|frontdesk']
  shift        text        [not null]
  work_date    date        [not null]
  snapshot     jsonb       [not null, note: '交班當下任務清單定格——之後任務再變，快照不變']
  generated_by text        [not null, note: 'CHECK: system|manager（班末掃描產生，主管可手動；假設 A8）']
  created_at   timestamptz [not null]
  Indexes {
    (tenant_id, work_date)
    (tenant_id, id) [unique, note: '複合外鍵落點']
  }
  Note: '交班單凍結快照（history，永不 UPDATE）。'
}

Table handover_signs {
  tenant_id   bigint      [not null, ref: > tenants.id]
  handover_id uuid        [not null]
  staff_id    uuid        [not null]
  signed_at   timestamptz [not null]
  Indexes {
    (handover_id, staff_id) [pk]
  }
  Note: '簽收（junction）；簽收另寫事件。'
}

Table notices {
  id         uuid        [pk]
  tenant_id  bigint      [not null, ref: > tenants.id]
  sender_id  uuid        [not null]
  title      text        [not null]
  body       text        [not null]
  recipients jsonb       [not null, note: '部門/個人混選 {"depts":[…],"staff_ids":[…]}；推播經 outbox 展開一人一封']
  created_at timestamptz [not null]
  Indexes {
    (tenant_id, created_at)
    (tenant_id, id) [unique, note: '複合外鍵落點']
  }
  Note: '通知板。逾時未讀升級屬 SLA 家族，v1 不做。'
}

Table notice_reads {
  tenant_id bigint      [not null, ref: > tenants.id]
  notice_id uuid        [not null]
  staff_id  uuid        [not null]
  read_at   timestamptz [not null]
  Indexes {
    (notice_id, staff_id) [pk, note: '打開即記、重開不重記']
  }
  Note: '已讀（junction）。'
}

Table lost_items {
  id          uuid        [pk]
  tenant_id   bigint      [not null, ref: > tenants.id]
  room_id     uuid        [note: '公共區拾獲可空']
  location    text        [note: '房外位置描述']
  item_desc   text        [not null]
  photo_ref   text        [note: '照片外存引用；事件 payload 只記 hasPhoto']
  status      text        [not null, note: 'CHECK: held|returned']
  found_by    uuid        [not null, note: '拾獲人（追責與對帳）']
  found_at    timestamptz [not null]
  returned_at timestamptz
  returned_to text        [note: 'PII：領回人稱謂——去識別化範圍']
  created_at  timestamptz [not null]
  Indexes {
    (tenant_id, status)
  }
  Note: '遺失物：櫃檯登記、歸還結案。'
}

Table leaves {
  id         uuid        [pk]
  tenant_id  bigint      [not null, ref: > tenants.id]
  staff_id   uuid        [not null]
  from_at    timestamptz [not null]
  to_at      timestamptz [not null]
  created_by uuid        [not null, note: '登記的主管']
  created_at timestamptz [not null]
  Indexes {
    (tenant_id, staff_id, from_at)
  }
  Note: '請假。登記當下觸發連鎖：accepted→pool、doing→interrupted（效果記事件，不回寫本表）。'
}

Table room_memory {
  id             uuid        [pk]
  tenant_id      bigint      [not null, ref: > tenants.id]
  room_id        uuid        [not null]
  kind           text        [not null, note: 'CHECK: repair|preference|incident']
  summary        text        [not null, note: '可能含住客線索——去識別化範圍']
  source_task_id uuid        [note: '追溯來源任務']
  occurred_at    timestamptz [not null]
  Indexes {
    (tenant_id, room_id, occurred_at)
  }
  Note: '投影（可重算）：這間房的往事，餵「查一下」。工務單完修時以 kind=repair 寫入（類別、處理說明、處理人）。查一下的回答與出處不得帶出住客身分（FR-046）。'
}

Table stats_daily {
  tenant_id          bigint      [not null, ref: > tenants.id]
  stat_date          date        [not null]
  sellable           int         [not null, note: '可賣房數']
  avg_response_min   numeric(6,1) [not null, note: '平均回應分鐘']
  rating_avg         numeric(3,2) [not null, note: '住客評分均值']
  inspection_returns int         [not null, note: '查房退回次數']
  completed_count    int         [not null]
  summary            text        [not null, note: '一行當日摘要']
  updated_at         timestamptz [not null]
  Indexes {
    (tenant_id, stat_date) [pk]
  }
  Note: '投影（worker 預算好，API 只讀不現算）。不變條件：取消單一律排除（E-15/SC-007）。'
}

Table phrase_counter {
  tenant_id    bigint      [not null, ref: > tenants.id]
  phrase       text        [not null, note: '住客常打字句——PII 風險，去識別化範圍']
  count        int         [not null]
  last_seen_at timestamptz [not null]
  suggested    boolean     [not null, default: false, note: '已建議轉按鈕']
  Indexes {
    (tenant_id, phrase) [pk]
  }
  Note: '投影（可重算）：高頻自由文字排行，餵「建議轉成按鈕」。'
}

// ===== 複合外鍵（(tenant_id, xxx_id) → 對方 (tenant_id, id)；外鍵檢查不經 RLS，擋跨租戶關聯）=====
Ref: staff_devices.(tenant_id, staff_id) > staff_accounts.(tenant_id, id)
Ref: push_deliveries.(tenant_id, recipient_staff_id) > staff_accounts.(tenant_id, id)
Ref: room_qr_tokens.(tenant_id, room_id) > rooms.(tenant_id, id)
Ref: guest_sessions.(tenant_id, room_id) > rooms.(tenant_id, id)
Ref: guest_sessions.(tenant_id, reservation_id) > reservations_cache.(tenant_id, id)
Ref: reservations_cache.(tenant_id, room_id) > rooms.(tenant_id, id)
Ref: tasks.(tenant_id, room_id) > rooms.(tenant_id, id)
Ref: tasks.(tenant_id, reservation_id) > reservations_cache.(tenant_id, id)
Ref: tasks.(tenant_id, assignee_id) > staff_accounts.(tenant_id, id)
Ref: tasks.(tenant_id, plan_id) > cleaning_plans.(tenant_id, id)
Ref: task_events.(tenant_id, task_id) > tasks.(tenant_id, id)
Ref: cleaning_plans.(tenant_id, id) < plan_rooms.(tenant_id, plan_id)
Ref: plan_rooms.(tenant_id, room_id) > rooms.(tenant_id, id)
Ref: plan_rooms.(tenant_id, staff_id) > staff_accounts.(tenant_id, id)
Ref: plan_rooms.(tenant_id, task_id) > tasks.(tenant_id, id)
Ref: task_sop_checks.(tenant_id, task_id) > tasks.(tenant_id, id)
Ref: task_sop_checks.(tenant_id, checked_by) > staff_accounts.(tenant_id, id)
Ref: inspections.(tenant_id, task_id) > tasks.(tenant_id, id)
Ref: inspections.(tenant_id, inspector_id) > staff_accounts.(tenant_id, id)
Ref: handover_signs.(tenant_id, handover_id) > handovers.(tenant_id, id)
Ref: handover_signs.(tenant_id, staff_id) > staff_accounts.(tenant_id, id)
Ref: notices.(tenant_id, sender_id) > staff_accounts.(tenant_id, id)
Ref: notice_reads.(tenant_id, notice_id) > notices.(tenant_id, id)
Ref: notice_reads.(tenant_id, staff_id) > staff_accounts.(tenant_id, id)
Ref: lost_items.(tenant_id, room_id) > rooms.(tenant_id, id)
Ref: lost_items.(tenant_id, found_by) > staff_accounts.(tenant_id, id)
Ref: leaves.(tenant_id, staff_id) > staff_accounts.(tenant_id, id)
Ref: leaves.(tenant_id, created_by) > staff_accounts.(tenant_id, id)
Ref: room_memory.(tenant_id, room_id) > rooms.(tenant_id, id)
Ref: room_memory.(tenant_id, source_task_id) > tasks.(tenant_id, id)
Ref: tenant_config.(tenant_id, updated_by) > staff_accounts.(tenant_id, id)

// ───────── 本 plan（001-staff-app-increment）新增 ─────────

Table repair_tickets {
  task_id         uuid        [pk, note: '= tasks.id（type=repair、dept=engineering、source=staff）。工務單是修繕任務的延伸資料，狀態與負責人一律看 tasks']
  tenant_id       bigint      [not null, ref: > tenants.id]
  ticket_no       text        [not null, note: '租戶內遞增單號，格式 W- 加 4 位數，例如 W-0410；由 repair_ticket_counters 取號']
  room_id         uuid        [not null, note: '由原任務帶入；冗餘自 tasks.room_id，供重複單查詢使用']
  category        text        [not null, note: 'CHECK: air_conditioning|plumbing_electrical|furniture_equipment|door_lock|other（冷氣、水電、家具／設備、門鎖、其他）']
  description     text        [note: '報修說明，選填。PII 去識別化範圍']
  reporter_id     uuid        [not null, note: '報修人；撤回與補照片的授權依據']
  source_task_id  uuid        [note: '開單時所在的原任務']
  resolution_note text        [note: '工務處理說明，完修時寫入，選填（no_action_needed 也一樣）。驗收不通過退回重修時清空，再完修時寫入這一次的說明']
  resolution_type text        [note: 'nullable。CHECK: fixed|temporary|cannot_fix|no_action_needed（已修好、暫時處理、無法修復、不需處理）。每次完修守衛成功後由 RepairService.resolveOnComplete 在同一交易寫入，請求省略時寫 fixed；驗收不通過退回重修時清空，再完修時寫入這一次的結果。所以 state 為 done 或 closed 時必有值（這個欄位出現前就完修的舊單例外，可能為 NULL），其他狀態為 NULL。no_action_needed 不要求完修照片、不建追蹤單、不改房況，完成當下 tasks 直接 closed，不進待驗收。對應 contracts RepairTicket.resolutionType、CompleteTaskRequest.resolutionType 與待驗收清單每列的完修結果']
  is_urgent       boolean     [not null, default: false, note: '本輪新增。目前是否仍視為急件；開單當下由系統依飯店設定規則判定寫入，房務不能更改，主管降級時轉為 false。與 tasks.urgent 同步（建單與降級時一併寫入），供待認領排序索引直接用 tasks.urgent 不需 JOIN 本表。對應 contracts RepairTicketSummary.isUrgent']
  urgent_rule     text        [note: '本輪新增，nullable。開單當下系統判定命中的規則說明（如「VIP · 15:00 入住」）；判定為一般件時為 NULL。主管降級後仍保留，供追溯原始判定理由。對應 contracts RepairTicket.urgentJudgement.rule']
  urgent_downgrade_reason text [note: '本輪新增，nullable。主管將急件降級為一般件時附的原因；未降級為 NULL。寫入時同一交易補一筆 task_events.type=urgent_downgraded。對應 contracts RepairTicket.urgentDowngradeReason']
  verified_by     uuid        [note: 'nullable。驗收通過的主管 staff_accounts.id（房務主管或工務主管皆可，含驗收自己完修的單），與 tasks done→closed 同一交易寫入，寫入後不改。尚未通過、或以 no_action_needed 結案（不經驗收）為 NULL。對應 contracts RepairTicket.verifiedBy（顯示名稱由 JOIN staff_accounts 取得）']
  verified_at     timestamptz [note: 'nullable。驗收通過的時間，規則同 verified_by。對應 contracts RepairTicket.verifiedAt']
  last_verify_failed_reason text [note: 'nullable。最近一次驗收不通過的原因，去掉頭尾空白後不得為空（空白由 API 擋下回 422，不進狀態轉移）；從沒被判不通過為 NULL。每次不通過覆寫上一次；重修、再完修、驗收通過都不清空，所以退回重修中、再次待驗收與已結案的詳情都讀得到最近一次的判定。歷次紀錄在 task_events.type=repair_verification_failed。PII 去識別化範圍']
  last_verify_failed_by     uuid [note: 'nullable。最近一次判不通過的主管 staff_accounts.id。與 last_verify_failed_reason、last_verify_failed_at 三欄同一句 UPDATE 寫入，三欄同為 NULL 或同有值。顯示名稱由 JOIN staff_accounts 取得']
  last_verify_failed_at     timestamptz [note: 'nullable。最近一次判不通過的時間，規則同 last_verify_failed_by。也是區分完修照片輪次的界線：uploaded_at 晚於它的 completion 照片屬於重修後這一輪']
  origin_ticket_task_id uuid  [note: '本輪新增，nullable，自我參照 repair_tickets.task_id。完修時 resolutionType=temporary 系統自動建立追蹤單時，追蹤單這欄指回原單；原單（非追蹤單）為 NULL。對應 contracts RepairTicket.originTicketNo（顯示時 JOIN 取原單 ticket_no）']
  origin          text        [not null, default: 'reported', note: '本輪新增。CHECK: reported|scheduled。reported＝有人報修（房務報修、工務自開、櫃檯交辦三條路徑都算）；scheduled＝每日排程規則建出的定期保養。工務首頁的「今日保養 {已完成}/{總數}」只數 scheduled 的那一群，報修的三個計數只數 reported，兩邊不重疊。對應 contracts engineeringSummary.maintenanceDone／maintenanceTotal']
  created_at      timestamptz [not null]
  Indexes {
    (tenant_id, ticket_no) [unique]
    (tenant_id, room_id, category) [note: '重複單檢查：同房同類別，再 JOIN tasks 過濾 state NOT IN (done, closed, cancelled)']
  }
  Note: '''
  工務單（FR-011–021）。狀態與負責人一律看 tasks（轉移全集見 tasks Note）：pool→accepted→doing→done→closed；doing→closed（no_action_needed）；
  done→accepted 或 pool（驗收不通過）；pool→cancelled（staff_withdrew）。
  送出時與原任務的中斷、照片綁定在同一交易：所有照片 status=uploaded 才能建立，否則整筆不落地，原任務也不變（FR-014）。
  急件改由系統判定（使用者裁決 C）：開單交易同時寫入 is_urgent／urgent_rule 與 tasks.urgent；主管降級（downgradeRepairTicketUrgency）只改 is_urgent 與 urgent_downgrade_reason，urgent_rule 保留原判定理由不變。
  開單去向：房務報修、工務自開、櫃檯交辦、定期保養一律直接進工務待認領（pool），一般件與急件都一樣，沒有主管審核；直開且帶 assigneeId 時直接 accepted。
  急件與一般件的差別只在急件推播與待認領排序。
  完修四選一（CompleteTaskRequest.resolutionType）：結果一律落地到本表 resolution_type（與 resolution_note、verified_by／verified_at、last_verify_failed_* 同一種「工務單延伸狀態放本表」的風格；
  清單與詳情直接讀欄位，不逐單翻 task_events 的 JSON），同時 task_events.completed 的 payload 也必帶同一值，欄位是投影、事件是真相，兩者由同一交易寫入。
    fixed（預設，無額外動作）；temporary（暫時處理）：同一交易自動建立一張房號、類別都相同的新 repair_tickets 列（origin_ticket_task_id 指回本單），走一般開單去向；
    cannot_fix（無法修復）：tasks.room_id 對應的 rooms.hk_state 轉 out_of_order；以上三種停在 done 等驗收，每次完修這次請求至少要帶 1 張完修照片。
    no_action_needed（不需處理）：不要求完修照片、不建追蹤單、不改房況，同一交易 tasks 直接 closed，不進待驗收。
    四種都照常推播報修人（repair_completed），原任務的停住原因同樣改成工務已處理、可以恢復。
    退回重修後再完修，以這一次的結果為準：temporary 會再建一張追蹤單、cannot_fix 會再把房轉 out_of_order。
  驗收（只有主管，房務主管與工務主管皆可，一次即定，先到先決；只接受 tasks.state=done 的單）：
    通過：done→closed，寫 verified_by／verified_at，task_events.type=repair_verified。不改房況（cannot_fix 的房維持 out_of_order），不推播。
    不通過：原因必填。同一交易寫 last_verify_failed_reason／_by／_at（覆寫上一次）、清空 resolution_type 與 resolution_note、清空 tasks.done_at，
      寫一筆 task_events.type=repair_verification_failed。原處理人在班時回他名下 accepted，並推播他（notifications.event=repair_verification_failed）；
      已下班或請假時回 pool，不推播個人（判定見 tasks Note）。已綁定的完修照片不解綁（repair_photos 綁定後不可改），歷次照片都留在這張單上。
    不通過紀錄同時存欄位與事件：事件是歷次紀錄的真相，可重放；欄位是詳情、推播文案與 App 直接讀的最近一次投影，
      只靠事件的話詳情每次都要逐單撈 task_events 再解 JSON，且「最近一次」要在讀取端自己挑。
  定期保養（origin=scheduled）：由 automation_rules 的 schedule 規則建出，直接進工務待認領；與報修單共用同一張表、同一套單號、生命週期與驗收，差別只在 origin 這一欄。
  工務首頁的報修三個計數（手上／今天已完修／急件）只數 origin=reported，「今日保養」只數 origin=scheduled，兩群互斥不重疊；「今天已完修」以 done_at 落在今天、state 為 done 或 closed 計。
  主管待驗收清單由 tasks 與本表既有欄位即時算出，不加欄位：tasks.state=done 且 resolution_type IS DISTINCT FROM 'no_action_needed'，排序用 tasks.done_at；判定全文見 tasks Note。
  驗收人與最近一次不通過判定人的顯示名稱，由 verified_by、last_verify_failed_by JOIN staff_accounts 取得。
  工務直開欄位對應（CreateRepairTicketRequest）：roomId／isPublicArea 決定 tasks.room_id（isPublicArea 時用既有公共區域佔位房，見 tasks 表待認領 NOOP 慣例，不新增欄位）；assigneeId 直接寫 tasks.assignee_id；呼叫者部門決定 tasks.source（房務報修與工務自開皆為 staff，櫃檯交辦為 desk，兩值已在既有 CHECK 內）。
  '''
}

Table repair_ticket_counters {
  tenant_id bigint [pk, ref: > tenants.id]
  last_no   int    [not null, default: 0, note: '取號：UPDATE … SET last_no=last_no+1 RETURNING，與建單同交易']
  Note: '工務單號序號（每租戶一列）。'
}

Table repair_ticket_contributors {
  tenant_id      bigint      [not null, ref: > tenants.id]
  ticket_task_id uuid        [not null]
  staff_id       uuid        [not null]
  granted_at     timestamptz [not null, note: '在開單前檢查時觸發這張單重複提示的時間']
  Indexes {
    (tenant_id, ticket_task_id, staff_id) [pk]
  }
  Note: '可以補照片的非報修人（FR-018）。報修人本身不需要列在這裡。'
}

Table repair_photos {
  id             uuid        [pk]
  tenant_id      bigint      [not null, ref: > tenants.id]
  ticket_task_id uuid        [note: '開單或補照片之前為空；綁定後不可改']
  purpose        text        [not null, note: 'CHECK: report|completion（報修照片或完修照片）']
  status         text        [not null, default: 'pending', note: 'CHECK: pending|uploaded；內容上傳成功才轉 uploaded，重試沿用同一個 id']
  storage_ref    text        [note: '照片外存引用（沿用 lost_items.photo_ref 慣例：本體不入庫）；uploaded 時必填']
  taken_at       timestamptz [not null, note: '拍攝時間，與 App 加上的「房號 · 拍攝時間」浮水印一致']
  uploaded_by    uuid        [not null]
  created_at     timestamptz [not null]
  uploaded_at    timestamptz
  Indexes {
    (tenant_id, ticket_task_id, purpose)
  }
  Note: '''
  工務單照片（兩段式：先建 pending 列取得 id，再上傳內容）。
  不變條件：一張工務單的 report 照片在開單時 1–3 張，每次補照片 1–3 張；修繕任務每次以 fixed、temporary、cannot_fix 完修時，這次請求至少帶 1 張 completion，no_action_needed 不要求。
  驗收不通過不解綁已綁定的 completion 照片；區分輪次看 uploaded_at 與 repair_tickets.last_verify_failed_at。
  未綁定的 pending 列由排程清理（保留期限依 tenant_config.retention_days）。
  '''
}

Table desk_notes {
  id         uuid        [pk]
  tenant_id  bigint      [not null, ref: > tenants.id]
  room_id    uuid        [not null]
  content    text        [not null, note: 'PII 去識別化範圍']
  author_id  uuid        [not null, note: '櫃檯員工']
  created_at timestamptz [not null]
  Indexes {
    (tenant_id, room_id, created_at)
  }
  Note: '櫃檯房間備註（FR-037），併入該房任務的交辦。有效期間（當日、本次入住或手動移除）尚未決定（NEEDS CLARIFICATION）；確定前不加失效欄位。'
}

Table handover_reads {
  tenant_id bigint      [not null, ref: > tenants.id]
  task_id   uuid        [not null]
  staff_id  uuid        [not null]
  read_at   timestamptz [not null, note: '第一次已讀的時間']
  Indexes {
    (tenant_id, task_id, staff_id) [pk, note: '展開交辦、開工、延後時記錄；重複動作不重記（ON CONFLICT DO NOTHING）']
  }
  Note: '交辦已讀（FR-038），員工 × 任務。'
}

Table kb_audit_logs {
  id              uuid        [pk, note: '= API 的 answerId']
  tenant_id       bigint      [not null, ref: > tenants.id]
  asker_id        uuid        [not null]
  task_id         uuid        [not null]
  question        text        [not null, note: 'PII 去識別化範圍']
  cited_kind      text        [not null, note: 'CHECK: sop|room_memory|none']
  cited_refs      jsonb       [note: '引用來源清單 [{kind, id, title, updated_on}]；查不到時為空']
  answer          text        [note: '查不到時為空；只由原文組成，不得含住客身分']
  feedback        text        [note: 'CHECK: helpful|unhelpful；未回饋時為空']
  escalated       boolean     [not null, default: false]
  created_at      timestamptz [not null]
  Indexes {
    (tenant_id, created_at)
    (tenant_id, task_id)
    (tenant_id, id) [unique, note: '複合外鍵落點']
  }
  Note: '查一下稽核紀錄（FR-045）。每次提問一列，回饋與轉問在同一列更新。'
}

Table kb_escalations {
  id           uuid        [pk]
  tenant_id    bigint      [not null, ref: > tenants.id]
  audit_log_id uuid        [not null, note: '對應的查一下稽核紀錄']
  question     text        [not null]
  asked_by     uuid        [not null]
  status       text        [not null, default: 'pending', note: 'CHECK: pending|answered']
  reply        text        [note: '主管回覆；回覆時推播提問員工']
  replied_by   uuid
  replied_at   timestamptz
  created_at   timestamptz [not null]
  Indexes {
    (tenant_id, status, created_at)
    (tenant_id, audit_log_id) [unique, note: '一則回答只能轉問一次']
  }
  Note: '問主管（FR-043）。主管從哪個入口回覆尚未決定（NEEDS CLARIFICATION），兩種入口都寫這張表。'
}

Table notifications {
  id                 uuid        [pk]
  tenant_id          bigint      [not null, ref: > tenants.id]
  recipient_staff_id uuid        [not null, note: '收件人']
  event              text        [not null, note: '本輪新增。CHECK: 與 contracts PushPayload.event 同一套十八值（pool_new_request｜inspection_passed｜inspection_failed｜spot_check_failed｜task_cancelled｜reassigned_away｜reassigned_to_me｜shift_end_returned｜guest_withdrew｜leave_takeover｜repair_completed｜repair_urgent｜repair_verification_failed｜kb_reply｜kb_unhelpful｜shift_end_still_interrupted｜unclaimed_reminder_staff｜unclaimed_reminder_manager）。outbox 的 kind=push 展開成一人一封時，把當時 payload 的 event 一併落地。通知中心靠它決定每一列的分類圖示與顏色，沒有這一欄，整頁的通知只能畫成同一種樣子。對應 contracts notifications.event']
  title              text        [not null, note: '推播標題全文，與 PushPayload.title 相同文案']
  body               text        [note: '選填']
  target             jsonb       [not null, note: '導頁去處，形狀＝contracts PushTarget（kind=task|ticket|pool|home；task 與 ticket 都帶 taskId，task 開任務頁、ticket 開工務單詳情，修繕任務的推播一律用 ticket；pool 帶 dept）；App 依 kind 機械導頁，不自己查任務類別']
  created_at         timestamptz [not null, note: '收到時間；通知中心依此新到舊排序，並以呼叫者時區日期分「今天」「更早」兩組（App 端分組，不在本表落地）']
  read_at            timestamptz [note: '標記已讀的時間；未讀為 NULL']
  Indexes {
    (tenant_id, recipient_staff_id, created_at) [note: '通知中心清單：新到舊']
  }
  Note: '''
  本輪新增。每位收件人可查詢、可標記已讀的持久通知清單；每筆對應一次推播事件的單一收件人紀錄
  （outbox kind=push 展開一人一封後，於同一交易一併寫入一筆本表，供 GET /notifications 等端點查詢；
  outbox 本身仍是一次性 relay，不保留可查詢歷史）。
  保留政策：依 tenant_config.notification_retention_days（預設 30 天）排程清除逾期列。
  event 與 title／body／target 一樣來自同一份 PushPayload，必須在展開那一筆交易裡一起寫；
  漏寫會讓該列的分類圖示掉回「一般」，而本表是 30 天就會被清掉的短期紀錄、沒有回填的權威來源。
  repair_verification_failed：主管驗收不通過、工務單回到原處理人名下時觸發，收件人是原處理人（退回後的 tasks.assignee_id）；單回到工務待認領時不發。
  文案帶房號、單號與不通過原因（repair_tickets.last_verify_failed_reason），target 與其他修繕事件一致為工務單詳情（kind=ticket，帶 taskId），
  與同交易寫入的 task_events.type=repair_verification_failed 對應。
  '''
}

Ref: notifications.(tenant_id, recipient_staff_id) > staff_accounts.(tenant_id, id)

Ref: tasks.(tenant_id, linked_repair_task_id) > tasks.(tenant_id, id)
Ref: repair_tickets.(tenant_id, task_id) > tasks.(tenant_id, id) // 一對一：task_id 為 PK
Ref: repair_tickets.(tenant_id, room_id) > rooms.(tenant_id, id)
Ref: repair_tickets.(tenant_id, reporter_id) > staff_accounts.(tenant_id, id)
Ref: repair_tickets.(tenant_id, source_task_id) > tasks.(tenant_id, id)
Ref: repair_tickets.(tenant_id, verified_by) > staff_accounts.(tenant_id, id)
Ref: repair_tickets.(tenant_id, last_verify_failed_by) > staff_accounts.(tenant_id, id)
Ref: repair_tickets.(tenant_id, origin_ticket_task_id) > repair_tickets.(tenant_id, task_id) // 追蹤單→原單，自我參照
Ref: repair_ticket_contributors.(tenant_id, ticket_task_id) > tasks.(tenant_id, id)
Ref: repair_ticket_contributors.(tenant_id, staff_id) > staff_accounts.(tenant_id, id)
Ref: repair_photos.(tenant_id, ticket_task_id) > tasks.(tenant_id, id)
Ref: repair_photos.(tenant_id, uploaded_by) > staff_accounts.(tenant_id, id)
Ref: desk_notes.(tenant_id, room_id) > rooms.(tenant_id, id)
Ref: desk_notes.(tenant_id, author_id) > staff_accounts.(tenant_id, id)
Ref: handover_reads.(tenant_id, task_id) > tasks.(tenant_id, id)
Ref: handover_reads.(tenant_id, staff_id) > staff_accounts.(tenant_id, id)
Ref: kb_audit_logs.(tenant_id, asker_id) > staff_accounts.(tenant_id, id)
Ref: kb_audit_logs.(tenant_id, task_id) > tasks.(tenant_id, id)
Ref: kb_escalations.(tenant_id, audit_log_id) > kb_audit_logs.(tenant_id, id)
Ref: kb_escalations.(tenant_id, asked_by) > staff_accounts.(tenant_id, id)
Ref: kb_escalations.(tenant_id, replied_by) > staff_accounts.(tenant_id, id)

Table automation_rules {
  id                uuid        [pk]
  tenant_id         bigint      [not null, ref: > tenants.id]
  name              text        [not null, note: 'UNIQUE (tenant_id, name)；出廠內建四條訂房屬性規則（VIP、親子、寵物、紀念日）']
  trigger_source    text        [not null, note: 'CHECK: reservation|schedule（訂房屬性｜每日排程）']
  condition         text        [not null, note: '訂房屬性值（如 VIP）或每日時點 HH:mm']
  category          text        [not null, note: 'CHECK: cleaning|amenity|repair|other（本輪新增 repair：每日排程規則建出的定期保養工單，寫進 repair_tickets 且 origin=scheduled）']
  room_no           text        [note: '排程規則可空＝公共區域']
  due_after_minutes int         [note: '建單後 N 分鐘到期，寫入 tasks.due_at']
  enabled           boolean     [not null, default: true]
  created_at        timestamptz [not null]
  updated_at        timestamptz [not null]
  Indexes {
    (tenant_id, name) [unique]
  }
  Note: '''
  SLA/自動化規則增補。規則命中建準備工單：source=system、pool_source=system、rule_hit=name；冪等鍵＝房號｜規則｜當地日期。刪除/停用不回收已建任務。
  本輪新增 category=repair（定期保養）：trigger_source=schedule 的規則命中時，除了建 tasks（type=repair、dept=engineering）之外，
  同一交易也要建對應的 repair_tickets 列並寫 origin=scheduled、取號照既有的 repair_ticket_counters。
  保養單直接進工務待認領，完修後與報修單一樣要主管驗收。
  **目前的排程粒度限制**：condition 是每日時點 HH:mm，所以一條規則＝每天建一次。
  「每 N 天／每月一次」這種週期還表達不出來，要支援得另立保養排程的資料面（週期、上次執行、設備台帳），
  本輪刻意不發明——先用既有機制讓「今日保養」這個概念能真的產生資料，週期化等有需求再談。
  '''
}
